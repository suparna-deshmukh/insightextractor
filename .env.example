# --- Gemini (free tier = 20 requests/day per key; keys rotate automatically) ---
GEMINI_API_KEY=your-primary-gemini-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.8-flash
# Daily request quota per key (defaults to 20 — the free-tier limit)
GEMINI_DAILY_QUOTA=20

# --- Per-user agent run window (ChatGPT-style rolling limit) ---
RUNS_PER_WINDOW=5
RUN_WINDOW_HOURS=5

# --- Shared state store (makes the global Gemini budget cross-instance on Vercel) ---
# Any Redis-compatible URL, e.g. a free Upstash DB:
# ASKCARD_REDIS_URL=rediss://default:PASS@host:6379
# Leave unset on localhost (file ledger in .askcard/ is used).

# --- Optional platform keys ---
# PRODUCTHUNT_API_TOKEN=
# YOUTUBE_API_KEY=
